# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=expirely
DB_SSLMODE=disable

# Server
SERVER_PORT=8080
ENV=development
FRONTEND_URL=http://localhost:8081

# JWT. Generate a unique value for each environment; never commit the real value.
JWT_SECRET=
JWT_EXPIRATION=24h
JWT_REFRESH_EXPIRATION=168h

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=10
REDIS_PERMISSION_TTL=10m

# Gemini AI. Comma-separate keys only in your untracked .env file.
AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite

# Firebase Admin SDK. Keep the service-account JSON outside Git.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_JSON=

# Development default only; configure this for your own seed data.
AUTH_DEFAULT_ADMIN_ROLE_ID=00000000-0000-0000-0000-000000000002
